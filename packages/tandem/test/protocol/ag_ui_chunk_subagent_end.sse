data: {"type":"TEXT_MESSAGE_CHUNK","delta":"nd."}

data: {"type":"SUBAGENT_FINISHED","subagentRunId":"s1"}

data: {"type":"SUBAGENT_STARTED","subagentRunId":"s2","name":"checker"}

data: {"type":"TEXT_MESSAGE_CHUNK","messageId":"m2","subagentRunId":"s2","delta":"Fail"}

data: {"type":"TEXT_MESSAGE_CHUNK","delta":"ed."}

data: {"type":"SUBAGENT_ERROR","subagentRunId":"s2","message":"Quota exceeded"}

data: {"type":"SUBAGENT_STARTED","subagentRunId":"s3","name":"writer"}

data: {"type":"TEXT_MESSAGE_CHUNK","messageId":"m3","subagentRunId":"s3","delta":"Re"}

data: {"type":"TEXT_MESSAGE_CHUNK","delta":"sult"}

data: {"type":"RUN_FINISHED","threadId":"thread-C","runId":"run-C1"}
